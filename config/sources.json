{
  "sources": {
    "claude_code": {
      "enabled": true,
      "paths": [
        "~/.claude/projects"
      ]
    },
    "codex": {
      "enabled": true,
      "paths": [
        "~/.codex/sessions",
        "\\\\wsl.localhost\\Debian\\root\\.codex\\sessions",
        "\\\\wsl.localhost\\Debian\\home\\*\\.codex\\sessions"
      ]
    },
    "opencode": {
      "enabled": true,
      "paths": [
        "~/.local/share/opencode/opencode.db"
      ]
    },
    "antigravity": {
      "enabled": true,
      "paths": [
        "~/.gemini/antigravity-cli/conversations",
        "~/.gemini/antigravity-cli/history.jsonl"
      ]
    },
    "gemini_cli": {
      "enabled": true,
      "paths": [
        "~/.gemini/tmp/*/chats"
      ]
    },
    "provider_usage": {
      "enabled": true,
      "paths": [
        "~/.claude/provider-usage"
      ]
    },
    "kimi": {
      "enabled": false,
      "paths": [
        "~/.kimi-code/sessions",
        "~/.kimi/sessions"
      ]
    },
    "dsh": {
      "enabled": false,
      "paths": [
        "~/.dsh/sessions"
      ]
    },
    "zylos": {
      "enabled": false,
      "paths": [
        "~/zylos/comm-bridge/c4.db"
      ]
    },
    "deepseek_balance": {
      "enabled": false,
      "paths": []
    },
    "importer": {
      "enabled": false,
      "paths": []
    }
  },
  "alerts": {
    "thresholds": [
      80,
      95
    ],
    "toast": false
  },
  "default_skin": "isometric",
  "recommend_task_kind": "implementation",
  "relabel": [
    {
      "under": "~/zylos",
      "harness": "zylos"
    }
  ],
  "zylos_previews": false,
  "deepseek_alert": 5.0
}
